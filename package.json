{
  "name": "factoryplane",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "pnpm dev:app",
    "dev:app": "pnpm --filter @factoryplane/app dev",
    "dev:website": "pnpm --filter @factoryplane/website dev",
    "build": "pnpm build:website && pnpm build:app",
    "build:app": "pnpm --filter @factoryplane/app build",
    "build:website": "pnpm --filter @factoryplane/website build",
    "start": "pnpm --filter @factoryplane/app start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "pnpm --filter @factoryplane/website typecheck && pnpm --filter @factoryplane/app typecheck",
    "test": "pnpm --filter @factoryplane/app test",
    "test:unit": "pnpm --filter @factoryplane/app test:unit",
    "test:e2e": "pnpm --filter @factoryplane/app test:e2e",
    "trigger:dev": "pnpm --filter @factoryplane/app trigger:dev",
    "trigger:deploy": "pnpm --filter @factoryplane/app trigger:deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15"
  }
}
