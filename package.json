{
  "name": "factoryplane",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --stream --filter @factoryplane/app --filter @factoryplane/website dev",
    "dev:app": "pnpm --filter @factoryplane/app dev",
    "dev:website": "pnpm --filter @factoryplane/website dev",
    "trigger:dev": "pnpm --filter @factoryplane/app trigger:dev",
    "trigger:deploy": "pnpm --filter @factoryplane/app trigger:deploy",
    "build": "pnpm -r --filter @factoryplane/app --filter @factoryplane/website build",
    "build:app": "pnpm --filter @factoryplane/app build",
    "build:website": "pnpm --filter @factoryplane/website build",
    "start": "pnpm -r --parallel --stream --filter @factoryplane/app --filter @factoryplane/website start",
    "start:app": "pnpm --filter @factoryplane/app start",
    "start:website": "pnpm --filter @factoryplane/website start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "pnpm --filter @factoryplane/app typecheck && pnpm --filter @factoryplane/website typecheck && tsc -p tsconfig.tests.json --noEmit --pretty false",
    "test": "pnpm test:unit",
    "test:unit": "find tests/unit tests/integration -name '*.test.ts' -print0 | xargs -0 node --experimental-strip-types --test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "typescript": "^5"
  }
}
