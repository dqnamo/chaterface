{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": [
				"CLOUDFLARE_AI_GATEWAY_ID",
				"CLOUDFLARE_API_TOKEN",
				"CLOUDFLARE_TASK_NAMING_MODEL",
				"E2B_API_KEY",
				"UPSTASH_BOX_API_KEY",
				"PREVIEW_SESSION_SECRET",
				"PREVIEWS_DOMAIN",
				"INSTANT_APP_ADMIN_TOKEN",
				"SECRET_ENCRYPTION_KEY",
				"TRIGGER_PROJECT_REF",
				"TRIGGER_SECRET_KEY",
				"WORKER_REDIS_URL"
			],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
