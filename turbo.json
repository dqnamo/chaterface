{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": [
				"UPSTASH_BOX_API_KEY",
				"PREVIEW_COOKIE_DOMAIN",
				"PREVIEW_SESSION_SECRET",
				"PREVIEWS_DOMAIN",
				"INSTANT_APP_ADMIN_TOKEN",
				"SECRET_ENCRYPTION_KEY",
				"TRIGGER_PROJECT_REF",
				"TRIGGER_SECRET_KEY"
			],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
