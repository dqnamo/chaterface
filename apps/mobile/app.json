{
	"expo": {
		"name": "Chaterface",
		"slug": "chaterface",
		"version": "0.1.0",
		"orientation": "portrait",
		"scheme": "chaterface",
		"userInterfaceStyle": "automatic",
		"ios": {
			"bundleIdentifier": "com.chaterface.app",
			"supportsTablet": true,
			"infoPlist": {
				"UIViewControllerBasedStatusBarAppearance": true,
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"package": "com.chaterface.app",
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"output": "static"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"backgroundColor": "#111113"
					}
				}
			],
			"expo-asset",
			"expo-font",
			"expo-image",
			"expo-web-browser",
			"expo-system-ui",
			"expo-status-bar"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
