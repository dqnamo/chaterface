{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/uniwind-types.d.ts"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"javascript": {
		"formatter": {
			"indentStyle": "tab",
			"indentWidth": 2
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab",
			"indentWidth": 2
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["apps/mobile/src/components/markdown/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noArrayIndexKey": "off",
						"useGetterReturn": "off"
					}
				}
			}
		},
		{
			"includes": [
				"apps/mobile/src/components/markdown/**",
				"apps/mobile/src/components/chat/conversation.tsx",
				"apps/mobile/src/components/chat/conversation.web.tsx",
				"apps/mobile/src/components/chat/prompt-input.web.tsx",
				"apps/mobile/src/components/icon.tsx",
				"apps/mobile/src/components/symbol-image.tsx",
				"apps/mobile/src/components/touchable-glass.tsx",
				"apps/mobile/src/components/tw.tsx"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": [
				"apps/mobile/src/components/chat/conversation.tsx",
				"apps/mobile/src/components/chat/conversation.web.tsx"
			],
			"linter": {
				"rules": {
					"correctness": {
						"useExhaustiveDependencies": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/mobile/src/global.css"],
			"linter": {
				"rules": {
					"suspicious": {
						"noDuplicateCustomProperties": "off"
					}
				}
			}
		}
	]
}
